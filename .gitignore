# Terraform state and plan files contain infrastructure details, keep them
# out of version control. Store state in a locked S3 backend instead.
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Provider cache and lock directory
.terraform/
.terraform.tfstate.lock.info

# Real variable files never get committed, only the .example does
*.tfvars
*.auto.tfvars
!terraform.tfvars.example

# Local editor and OS noise
*.swp
.DS_Store
.idea/
.vscode/
